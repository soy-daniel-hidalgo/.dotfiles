[user]
	name = soy-daniel-hidalgo
	email = contact@danielhidalgo.dev
[init]
	defaultBranch = main
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true    # use n and N to move between diff sections
	dark = true        # or light = true, or omit for auto-detection
	side-by-side = true
	line-numbers = true
[merge]
	conflictstyle = zdiff3
[web]
	browser = zen
[browser "zen"]
	cmd = zen-browser \"$@\"

