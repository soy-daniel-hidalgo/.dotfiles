# ========================================================
# Ghostty - Terminal Emulator Config
# Docs: https://ghostty.org/docs/config/reference
# =========================================================

# General
language = en

# Font
font-size = 15

# Background
background-opacity = 0.9
background-blur = true
background-opacity-cells = true

# Theme
# theme = light:Catppuccin Macchiato,dark:Catppuccin Mocha
theme = Catppuccin Mocha

# GTK4
gtk-titlebar = false

# Cursor
cursor-style = block
adjust-cursor-thickness = 5

# Window
window-padding-x = 0
window-padding-y = 0
window-decoration = none
